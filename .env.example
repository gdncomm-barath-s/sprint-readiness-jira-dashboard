# Jira Cloud Configuration
# Copy this file to .env and fill in your values

# Your Jira Cloud domain (e.g., yourcompany.atlassian.net)
JIRA_DOMAIN=yourcompany.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=your.email@example.com

# Jira API Token (generate at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_api_token_here

# Server port (optional, defaults to 3000)
PORT=3000

# ============ MS Teams Integration (Optional) ============
# To send Teams notifications to a channel, create an Incoming Webhook:
#
# Setup steps:
# 1. In MS Teams, go to the channel where you want notifications
# 2. Click the "..." menu next to the channel name
# 3. Select "Connectors" (or "Manage channel" > "Connectors")
# 4. Find "Incoming Webhook" and click "Configure"
# 5. Give it a name like "Jira Dashboard" and optionally upload an icon
# 6. Click "Create" and copy the webhook URL
# 7. Paste the URL below

TEAMS_WEBHOOK_URL=
